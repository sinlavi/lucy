<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B8E66A</item>
        <item name="android:statusBarColor">#111411</item>
        <item name="android:navigationBarColor">#111411</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111411</item>
    </style>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#5C8426</item>
        <item name="android:statusBarColor">#F6F7F2</item>
